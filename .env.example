# ─── 服务端配置 ────────────────────────────────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agency_agents
CLIENT_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5174
INGEST_ROOT=c:\Users\v_liyixili\Desktop\new2026\agency-agents

# ─── JWT 认证 ──────────────────────────────────────────────────────────────────
JWT_SECRET=agency-agents-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# ─── AI 提供商（ollama | openai）────────────────────────────────────────────
ACTIVE_PROVIDER=ollama

# ─── Ollama 配置（本地大模型）──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud

# ─── OpenAI 配置 ───────────────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_TEXT_MODEL=gpt-5.4-ca
OPENAI_VISION_MODEL=gpt-4o-ca

# ─── Pipeline 模型配置 ─────────────────────────────────────────────────────────
# 强模型（用于前端/质检/编译修复等关键步骤，留空则使用默认模型）
# PIPELINE_STRONG_MODEL=gpt-4o
# 编程任务 temperature（越低越确定性，推荐 0.2-0.4）
PIPELINE_TEMPERATURE=0.3
# 模型能力等级：auto | high | medium | low（auto=根据模型名自动推断）
PIPELINE_MODEL_TIER=auto
# 每步最大输出 token 数（0=使用默认值，建议弱模型设为 8192-16384）
# PIPELINE_MAX_TOKENS=0