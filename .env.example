# ─── 服务端配置 ────────────────────────────────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agency_agents
CLIENT_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5174
INGEST_ROOT=c:\Users\v_liyixili\Desktop\new2026\agency-agents

# ─── JWT 认证 ──────────────────────────────────────────────────────────────────
JWT_SECRET=agency-agents-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# ─── AI 提供商（ollama | openai | claude | gemini | deepseek）────────────────
ACTIVE_PROVIDER=ollama

# ─── Ollama 配置（本地大模型）──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud

# ─── OpenAI 配置 ───────────────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_TEXT_MODEL=gpt-5.4-ca
OPENAI_VISION_MODEL=gpt-4o-ca

# ─── Claude (Anthropic) 配置 ──────────────────────────────────────────────────
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_TEXT_MODEL=claude-sonnet-4-20250514
CLAUDE_VISION_MODEL=claude-sonnet-4-20250514

# ─── Gemini (Google) 配置 ─────────────────────────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ─── DeepSeek 配置 ────────────────────────────────────────────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat

# ─── 模型路由策略 ─────────────────────────────────────────────────────────────
# manual=手动指定, auto=根据任务自动选择, fallback=主模型失败自动降级
MODEL_ROUTING_STRATEGY=manual
# Fallback Provider 链（逗号分隔，如 'openai,claude,deepseek'）
# FALLBACK_PROVIDERS=openai,claude

# ─── Pipeline 模型配置 ─────────────────────────────────────────────────────────
# 强模型（用于前端/质检/编译修复等关键步骤，留空则使用默认模型）
# PIPELINE_STRONG_MODEL=gpt-4o
# 编程任务 temperature（越低越确定性，推荐 0.2-0.4）
PIPELINE_TEMPERATURE=0.3
# 模型能力等级：auto | high | medium | low（auto=根据模型名自动推断）
PIPELINE_MODEL_TIER=auto
# 每步最大输出 token 数（0=使用默认值，建议弱模型设为 8192-16384）
# PIPELINE_MAX_TOKENS=0

# ─── Token 配额管理 ───────────────────────────────────────────────────────────
# 全局每日 Token 预算（0=不限制）
# DAILY_TOKEN_BUDGET=0
# 单用户每日 Token 配额（0=不限制）
# USER_DAILY_TOKEN_QUOTA=0
# API 限流：每分钟最大请求数（0=不限制）
# RATE_LIMIT_PER_MINUTE=0

# ─── 多租户 ──────────────────────────────────────────────────────────────────
# MULTI_TENANT_ENABLED=false

# ─── RAG 向量检索 ─────────────────────────────────────────────────────────────
# 向量嵌入 Provider（使用 LLM Provider 的 embedding 接口）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度（text-embedding-3-small=1536）
EMBEDDING_DIMENSION=1536